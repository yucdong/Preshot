<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-US" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="LaunchApp">Launch Preshot</String>
    <String Id="DowngradeErrorMessage">A newer version of Preshot is already installed.</String>
    <String Id="PathEnvVarFeature">Add Preshot to the system PATH so it can be launched from the command line.</String>
    <String Id="InstallAppFeature">Install Preshot.</String>
    <String Id="LegacyMachineInstallMessage">An older machine-wide Preshot installation was detected. Uninstall it from Windows Installed apps, then run this installer again. Your projects and materials will be preserved.</String>
    <String Id="LegacyUserInstallMessage">An older per-user Preshot installation was detected. Uninstall it from Windows Installed apps in that user's account, then run this installer again. Your projects and materials will be preserved.</String>
    <String Id="DataRetentionMessage">Choose your working directory when Preshot first opens. Uninstall removes application files and preserves your personal configuration, materials, and projects.</String>
</WixLocalization>
