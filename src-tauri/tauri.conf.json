{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Preshot",
  "version": "0.0.1",
  "identifier": "com.yucdong.preshot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Preshot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "yucdong",
    "homepage": "https://github.com/yucdong/Preshot",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../LICENSES/GITHUB-COPILOT-SDK-MIT.txt": "licenses/GITHUB-COPILOT-SDK-MIT.txt",
      "../LICENSES/GITHUB-COPILOT-CLI-LICENSE.md": "licenses/GITHUB-COPILOT-CLI-LICENSE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": {
          "en-US": {
            "localePath": "wix/en-US.wxl"
          }
        },
        "template": "wix/main.wxs",
        "upgradeCode": "493c5fb5-639d-4fba-94d3-aebe4eb0dce6"
      }
    }
  }
}
