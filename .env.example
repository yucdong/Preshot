# Midscene uses Chat Completions, while gpt-5.6-sol on the local proxy uses Responses.
# Run `pnpm midscene:proxy` to start the local protocol bridge.
MIDSCENE_MODEL_BASE_URL="http://127.0.0.1:4142/v1"
MIDSCENE_MODEL_API_KEY="local-proxy"
MIDSCENE_MODEL_NAME="gpt-5.6-sol"
MIDSCENE_MODEL_FAMILY="gpt-5"
MIDSCENE_UPSTREAM_BASE_URL="http://localhost:4141/v1"
MIDSCENE_MODEL_RETRY_COUNT="3"
MIDSCENE_MODEL_RETRY_INTERVAL="3000"
