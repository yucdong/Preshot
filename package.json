{
  "name": "preshot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1 dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1 build",
    "production:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-build.ps1",
    "production:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/production-verify.ps1",
    "release:set-version": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-set-version.ps1",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:init": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/init.Tests.ps1",
    "test:production-scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/production-tools.Tests.ps1",
    "test:agent-evals": "tsx scripts/run-agent-evals.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:blocknote": "playwright test --config playwright.blocknote.config.ts",
    "test:e2e:capture": "playwright test --config playwright.capture.config.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "midscene:proxy": "node scripts/midscene-responses-bridge.mjs",
    "midscene:model:verify": "midscene model verify",
    "midscene:smoke": "node scripts/midscene-smoke.mjs",
    "midscene:report:merge": "node scripts/merge-midscene-plan-text-reports.mjs",
    "dev:midscene": "vite --mode midscene --host 127.0.0.1 --port 1423",
    "test:midscene:web": "vitest run --config vitest.midscene.config.ts",
    "migrate:project": "tsx scripts/migrate-project-manifest.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.53.0",
    "@blocknote/mantine": "0.53.0",
    "@blocknote/react": "0.53.0",
    "@blocknote/xl-docx-exporter": "0.53.0",
    "@blocknote/xl-multi-column": "0.53.0",
    "@blocknote/xl-pdf-exporter": "0.53.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-pdf/renderer": "4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-store": "2.4.4",
    "docx": "9.6.1",
    "fonteditor-core": "2.6.3",
    "i18next": "^26.3.6",
    "konva": "^10.3.0",
    "lucide-react": "^1.28.0",
    "modern-screenshot": "4.7.0",
    "pdf-lib": "^1.17.1",
    "prosemirror-history": "1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-konva": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@midscene/cli": "1.10.9-beta-20260804051439.0",
    "@midscene/core": "1.10.9-beta-20260804051439.0",
    "@midscene/web": "1.10.9-beta-20260804051439.0",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv": "16.6.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "1.55.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.43.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
